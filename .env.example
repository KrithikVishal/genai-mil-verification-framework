# Groq API Configuration Template
# Copy this file to .env and insert your API key:
# cp .env.example .env

# Your Groq API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: LLM model to use (default: openai/gpt-oss-120b)
# Supported options: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b
